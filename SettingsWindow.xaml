<Window x:Class="KioskBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk Browser Settings"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Kiosk Browser Settings"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Configure your kiosk browser experience"
                      FontSize="14"
                      Foreground="{StaticResource TextSecondaryBrush}"
                      Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Settings -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="General Settings"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,12"/>

                        <!-- Home Page -->
                        <TextBlock Text="Home Page URL"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBox x:Name="HomePageTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Margin="0,0,0,16"/>

                        <!-- Start Fullscreen -->
                        <CheckBox x:Name="StartFullscreenCheckBox"
                                 Content="Start in fullscreen mode"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                        <!-- Show Virtual Keyboard -->
                        <CheckBox x:Name="ShowKeyboardCheckBox"
                                 Content="Show virtual keyboard button"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                        <!-- Enable Context Menu -->
                        <CheckBox x:Name="EnableContextMenuCheckBox"
                                 Content="Enable right-click context menu"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                        <!-- Enable Zoom -->
                        <CheckBox x:Name="EnableZoomCheckBox"
                                 Content="Enable zoom controls (Ctrl +/-)"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                        <!-- Enable Printing -->
                        <CheckBox x:Name="EnablePrintingCheckBox"
                                 Content="Enable printing"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>

                <!-- Security Settings -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Security Settings"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,12"/>

                        <!-- Idle Timeout -->
                        <TextBlock Text="Idle Timeout (minutes, 0 to disable)"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBox x:Name="IdleTimeoutTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Margin="0,0,0,12"/>

                        <!-- Blocked Domains -->
                        <TextBlock Text="Blocked Domains (comma-separated)"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBox x:Name="BlockedDomainsTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Height="80"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,8"/>
                        <TextBlock Text="Example: facebook.com, youtube.com, twitter.com"
                                  FontSize="12"
                                  FontStyle="Italic"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>

                <!-- Download Settings -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Download Settings"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,12"/>

                        <!-- Allow Downloads -->
                        <CheckBox x:Name="AllowDownloadsCheckBox"
                                 Content="Allow file downloads"
                                 FontSize="14"
                                 Margin="0,0,0,12"
                                 Checked="AllowDownloadsCheckBox_Changed"
                                 Unchecked="AllowDownloadsCheckBox_Changed"/>

                        <!-- Download Path -->
                        <TextBlock Text="Download Path"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DownloadPathTextBox"
                                    Grid.Column="0"
                                    Style="{StaticResource ModernTextBox}"
                                    IsEnabled="False"/>
                            <Button Grid.Column="1"
                                   Content="Browse"
                                   Style="{StaticResource ModernButton}"
                                   Click="BrowseDownloadPath_Click"
                                   Margin="8,0,0,0"
                                   x:Name="BrowseButton"
                                   IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                   Content="Reset to Defaults"
                   Style="{StaticResource ModernButton}"
                   Click="ResetButton_Click"
                   Background="{StaticResource WarningBrush}"/>

            <Button Grid.Column="2"
                   Content="Cancel"
                   Style="{StaticResource ModernButton}"
                   Click="CancelButton_Click"
                   Background="{StaticResource SecondaryBrush}"
                   Margin="0,0,8,0"/>

            <Button Grid.Column="3"
                   Content="Save Settings"
                   Style="{StaticResource ModernButton}"
                   Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
